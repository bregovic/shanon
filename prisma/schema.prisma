  base       String   @default("CZK") @db.VarChar(3)
  source     String   @default("manual") @db.VarChar(40)
  ext        Json     @default("{}")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by") @db.Uuid
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by") @db.Uuid

  currency SysCurrency @relation("SysExchangeRate_currency", fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([tenantId, currencyId, date, base, source])
  @@index([tenantId])
  @@index([currencyId])
  @@map("sys_exchange_rate")
}

