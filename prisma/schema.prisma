model TaxCode {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  code          String   @db.VarChar(20)
  name          String   @db.VarChar(120)
  rate          Decimal  @db.Decimal(7, 4)
  direction     String   @db.VarChar(40)
  reverseCharge Boolean  @default(false) @map("reverse_charge")
  accountId     String   @map("account_id") @db.Uuid
  reportLine    String?  @map("report_line") @db.VarChar(10)
  khSection     String?  @map("kh_section") @db.VarChar(4)
  ext           Json     @default("{}")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") @db.Uuid

  company SysCompany @relation("TaxCode_company", fields: [companyId], references: [id], onDelete: Restrict)
  account GlAccount  @relation("TaxCode_account", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@index([accountId])
  @@map("tax_code")
}
