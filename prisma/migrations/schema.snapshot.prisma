/// sys.numberSeq — generováno z definice objektu
model SysNumberSeq {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  code       String   @db.VarChar(20)
  name       String   @db.VarChar(120)
  format     String   @db.VarChar(40)
  nextNumber Int      @default(1) @map("next_number")
  usedFor    String?  @map("used_for") @db.VarChar(40)
  continuous Boolean  @default(false)
  ext        Json     @default("{}")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by") @db.Uuid
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by") @db.Uuid

  company                  SysCompany         @relation("SysNumberSeq_company", fields: [companyId], references: [id], onDelete: Restrict)
  sysNumberSeqFree_seq     SysNumberSeqFree[] @relation("SysNumberSeqFree_seq")
  glJournalName_voucherSeq GlJournalName[]    @relation("GlJournalName_voucherSeq")

  @@unique([tenantId, companyId, code])
  @@unique([tenantId, companyId, usedFor])
  @@index([tenantId, companyId])
  @@map("sys_number_seq")
}

/// sys.currency — generováno z definice objektu
model SysCurrency {
