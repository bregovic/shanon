// Shanon — systémové tabulky psané ručně.
// Tabulky objektů (moduly) generuje `npm run schema:gen` do schema.prisma
// z definic v src/modules. schema.prisma NEUPRAVOVAT RUČNĚ.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Zákazník platformy (tenant). Data všech tabulek objektů jsou oddělená
/// podle tenant_id a hlídá je Row Level Security (scripts/rls.ts).
model SysTenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  /// vlastní úložiště souborů tenanta (S3/R2), šifrovaná konfigurace
  storage   Json?
  createdAt DateTime @default(now()) @map("created_at")

  users      SysUser[]
  modules    SysTenantModule[]
  companyModules SysCompanyModule[]
  extensions SysTenantExtension[]
  labels     SysLabelOverride[]

  @@map("sys_tenant")
}

model SysUser {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @unique @db.VarChar(254)
  /// celé jméno (Jméno Příjmení) — skládá se z firstName a lastName
  name         String   @db.VarChar(120)
  firstName    String   @default("") @map("first_name") @db.VarChar(60)
  lastName     String   @default("") @map("last_name") @db.VarChar(60)
  passwordHash String   @map("password_hash")
  /// admin = superuživatel tenanta (všechny firmy, moduly, role); user = podle přiřazení k firmám
  role         String   @default("user") @db.VarChar(20)
  lang         String   @default("cs") @db.VarChar(5)
  active       Boolean  @default(true)
  /// PIN do pokladny (bcrypt) — rychlé přihlášení pokladní u terminálu
  posPinHash   String?  @map("pos_pin_hash")
  /// e-mailová upozornění, která si uživatel zapnul: { dailySummary, overdueInvoices, integrationErrors }
  notify       Json     @default("{}")
  /// firma, do které se uživatel přihlásí (prázdné / bez přístupu = první dostupná)
  defaultCompanyId String? @map("default_company_id") @db.Uuid
  /// pozvánka / reset hesla: SHA-256 jednorázového tokenu z odkazu (token samotný se neukládá) a jeho platnost
  inviteTokenHash String?   @map("invite_token_hash") @db.VarChar(64)
  inviteExpiresAt DateTime? @map("invite_expires_at")
  /// kdy odešla poslední pozvánka; heslo si uživatel nastavil = passwordSetAt
  invitedAt       DateTime? @map("invited_at")
  passwordSetAt   DateTime? @map("password_set_at")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant    SysTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions  SysSession[]
  favorites SysFavorite[]
  recents   SysRecent[]
  companies SysUserCompany[]

  @@index([tenantId])
  @@map("sys_user")
}

model SysSession {
  /// SHA-256 tokenu z cookie (token samotný se neukládá)
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user SysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sys_session")
}

/// Účet aplikace Portál (zaměstnanec / dodavatel) — mimo uživatele Shanonu, bez licence.
/// Zaměstnanec: přihlašovací jméno = osobní číslo, heslo; dodavatel: e-mail, přihlášení odkazem z e-mailu.
/// Firmy a oprávnění se odvozují z karet (hr.employee / int.portalContact) při každém přihlášení.
/// Aplikační role k tabulce práva nemá — čte ji jen přihlášení portálu (src/server/portal-auth.ts).
model SysPortalAccount {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// employee | vendor
  kind         String    @db.VarChar(10)
  /// osobní číslo (velkými) / e-mail (malými)
  login        String    @db.VarChar(254)
  passwordHash String?   @map("password_hash")
  /// jednorázový odkaz (pozvánka, přihlášení, nové heslo) — jen SHA-256
  tokenHash    String?   @map("token_hash") @db.VarChar(64)
  tokenExpires DateTime? @map("token_expires")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  /// poslední firma a agenda (nabídnou se při dalším otevření)
  prefs        Json      @default("{}")
  invitedAt    DateTime? @map("invited_at")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions SysPortalSession[]

  @@unique([tenantId, kind, login])
  @@index([tokenHash])
  @@map("sys_portal_account")
}

model SysPortalSession {
  /// SHA-256 tokenu z cookie
  id        String   @id @db.VarChar(64)
  accountId String   @map("account_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  account SysPortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("sys_portal_session")
}

/// Zapnuté moduly tenanta (obdoba konfiguračních klíčů v AX).
/// Moduly zapnuté ve firmě (agenda firmy); sys_tenant_module = souhrn přes firmy (src/server/modules.ts).
model SysCompanyModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  moduleId  String   @map("module_id") @db.VarChar(40)
  enabledAt DateTime @default(now()) @map("enabled_at")

  tenant SysTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([companyId, moduleId])
  @@index([tenantId])
  @@map("sys_company_module")
}

model SysTenantModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleId  String   @map("module_id") @db.VarChar(40)
  enabledAt DateTime @default(now()) @map("enabled_at")

  tenant SysTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleId])
  @@map("sys_tenant_module")
}

/// Zapnutá rozšíření tenanta.
model SysTenantExtension {
  tenantId    String   @map("tenant_id") @db.Uuid
  extensionId String   @map("extension_id") @db.VarChar(60)
  enabledAt   DateTime @default(now()) @map("enabled_at")

  tenant SysTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, extensionId])
  @@map("sys_tenant_extension")
}

/// Přepis labelu pro tenanta (vlastní názvosloví bez zásahu do kódu).
model SysLabelOverride {
  tenantId String @map("tenant_id") @db.Uuid
  lang     String @db.VarChar(5)
  labelId  String @map("label_id") @db.VarChar(80)
  text     String @db.VarChar(255)

  tenant SysTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, lang, labelId])
  @@map("sys_label_override")
}

/// Auditní stopa změn záznamů objektů.
model SysAudit {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  objectId  String   @map("object_id") @db.VarChar(60)
  recordId  String   @map("record_id") @db.Uuid
  action    String   @db.VarChar(10)
  userId    String?  @map("user_id") @db.Uuid
  changes   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, objectId, recordId])
  @@map("sys_audit")
}

/// Poznámky a soubory k libovolnému záznamu (DocuRef).
model SysDocuRef {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  objectId  String   @map("object_id") @db.VarChar(60)
  recordId  String   @map("record_id") @db.Uuid
  /// note | file
  kind      String   @db.VarChar(10)
  name      String   @db.VarChar(255)
  note      String?
  mime      String?  @db.VarChar(120)
  size      Int?
  /// kde leží obsah souboru: db (sys_file_blob) nebo s3 (úložiště tenanta)
  storage   String?  @db.VarChar(10)
  storageKey String? @map("storage_key") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@index([tenantId, objectId, recordId])
  @@map("sys_docuref")
}

/// Obsah souborů uložených v databázi (výchozí úložiště).
model SysFileBlob {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  data     Bytes

  @@index([tenantId])
  @@map("sys_file_blob")
}

/// Oblíbené stránky uživatele.
model SysFavorite {
  userId    String   @map("user_id") @db.Uuid
  href      String   @db.VarChar(1000)
  label     String   @db.VarChar(120)
  /// složka v menu oblíbených (prázdná = bez složky)
  folder    String?  @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")

  user SysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, href])
  @@map("sys_favorite")
}

/// Nedávné: posledně otevřené funkce z menu uživatele (drží se 10 nejnovějších, starší se mažou)
model SysRecent {
  userId   String   @map("user_id") @db.Uuid
  href     String   @db.VarChar(1000)
  label    String   @db.VarChar(120)
  module   String   @default("") @db.VarChar(120)
  openedAt DateTime @default(now()) @map("opened_at")

  user SysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, href])
  @@index([userId, openedAt])
  @@map("sys_recent")
}

/// Přiřazení uživatele k firmě (účetní jednotce) — obdoba přiřazení rolí
/// k organizacím v D365. Bez přiřazení firmu nevidí (kromě superuživatele).
model SysUserCompany {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// správce firmy: v této firmě smí vše, spravuje její uživatele
  admin     Boolean  @default(false)
  /// role (sys_role.id) platné v této firmě
  roleIds   String[] @default([]) @map("role_ids") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user SysUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([tenantId, companyId])
  @@map("sys_user_company")
}

/// Jedinečné klíče napříč všemi tenanty (jednoduchá adresa dodavatelského portálu…).
/// Bez RLS: veřejná adresa se hledá dřív, než je známý tenant. Zápis jen přes DataApi.claimGlobalKey.
model SysGlobalKey {
  namespace String   @db.VarChar(40)
  key       String   @db.VarChar(80)
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  /// záznam, kterému klíč patří (id portálu…)
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@id([namespace, key])
  @@index([tenantId, ownerId])
  @@map("sys_global_key")
}
